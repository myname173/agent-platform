# =================================================================
# agent-platform secrets & instance config
# Copy to `.env` (gitignored) and fill in real values.
# =================================================================

# n8n image version (pinned; upgrade deliberately)
N8N_VERSION=2.37.7

# n8n credential encryption key.
# First boot auto-generates one into the n8n_data volume (config file);
# read it with: docker exec n8n cat /home/node/.n8n/config
# Changing it after credentials exist makes them undecryptable.
N8N_ENCRYPTION_KEY=

# Task runners auth (n8n internal)
N8N_RUNNERS_AUTH_TOKEN=

# Chat Gateway Bearer key — MUST match LobeChat's OPENAI_API_KEY in
# docker-compose.yml; rotate both together.
CHAT_API_KEY=sk-n8n-agent

# n8n public API key (create in n8n: Settings → n8n API).
# Used by Kiranism server routes (frontent/.env.local) and the retention
# workflow inside n8n itself. Needs workflow + data table scopes.
N8N_API_KEY=

# Data retention (days) for the gateway's data tables
RETENTION_DAYS_MESSAGES=30
RETENTION_DAYS_EXECUTIONS=90

# LobeChat access code (UI entry password)
LOBECHAT_ACCESS_CODE=

# LobeChat / NextAuth secret (Auth.js v5 reads AUTH_SECRET; set both for
# backwards compat). Generate: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_SECRET=
