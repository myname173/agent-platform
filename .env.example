# =================================================================
# agent-platform secrets & instance config
# Copy to `.env` (gitignored) and fill in real values.
# =================================================================

# n8n image version (pinned; upgrade deliberately)
N8N_VERSION=2.37.7

# n8n credential encryption key.
# First boot auto-generates one into the n8n_data volume (config file);
# read it with: docker exec n8n cat /home/node/.n8n/config
# Changing it after credentials exist makes them undecryptable.
N8N_ENCRYPTION_KEY=

# Task runners auth (n8n internal)
N8N_RUNNERS_AUTH_TOKEN=

# Chat Gateway Bearer key — MUST match LobeChat's OPENAI_API_KEY in
# docker-compose.yml; rotate both together.
CHAT_API_KEY=

# n8n public API key (create in n8n: Settings → n8n API).
# Used by Kiranism server routes (frontent/.env.local) and the retention
# workflow inside n8n itself. Needs workflow + data table scopes.
N8N_API_KEY=

# Data retention (days) for the gateway's data tables
RETENTION_DAYS_MESSAGES=30
RETENTION_DAYS_EXECUTIONS=90
RETENTION_DAYS_IDEMPOTENCY=7
IDEMPOTENCY_WINDOW_SEC=300
MAX_TOOL_ROUNDS=2

# LobeChat access code (UI entry password)
LOBECHAT_ACCESS_CODE=

# LobeChat / NextAuth secret (Auth.js v5 reads AUTH_SECRET; set both for
# backwards compat). Generate: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_SECRET=

# Postgres datastore for n8n (primary DB; volume postgres_data)
POSTGRES_USER=n8n
POSTGRES_PASSWORD=
POSTGRES_DB=n8n

# DashScope (阿里百炼) API key — kb embeddings via qwen3.7-text-embedding
DASHSCOPE_API_KEY=

# 错误率告警（Chat Alerts workflow）
ALERT_WINDOW_MIN=60
ALERT_RATE_THRESHOLD=0.5
ALERT_MIN_TOTAL=5
ALERT_COOLDOWN_MIN=60
# 模型成本预算告警（24h 花费；warn → critical 升级不受去重限制）
ALERT_COST_24H_USD=2
ALERT_COST_CRITICAL_USD=5


# LobeHub 2.x（服务端数据库模式）
LOBECHAT_DATABASE_URL=postgres://lobechat:CHANGE_ME@postgres:5432/lobechat
LOBECHAT_OPENAI_API_KEY=
# Better Auth / 加密（KEY_VAULTS_SECRET=openssl rand -base64 32；JWKS_KEY 为 RS256 JWK Set JSON）
KEY_VAULTS_SECRET=
JWKS_KEY=

# Object storage root credentials. The compose service is still called `minio`
# (and the volume `minio_data`) but the image is now rustfs/rustfs — the MinIO
# community image was pulled from Docker Hub. docker-compose feeds these to both
# that service and LobeHub's S3_* vars — they must stay identical or presigned
# uploads fail with 403. The secret has a minimum length of 8 characters.
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME

# Optional: override the SERVER-SIDE S3 endpoint. LobeHub uses two S3 clients:
# the presign client (built from S3_ENDPOINT in docker-compose.yml — this is the
# address the BROWSER is handed) and an internal client (built from this value).
# If this is unset the internal client falls back to S3_ENDPOINT, which makes
# every server-side call (the object stat taken before signing, delete, multipart
# create) depend on PLATFORM_LAN_IP — change networks and they fail with
# ECONNREFUSED on upload.createS3PreSignedUrl. docker-compose.yml already
# defaults it to the stable Docker service name, so normally leave this alone;
# set it only to point the server side at an external S3.
# S3_INTERNAL_ENDPOINT=http://minio:9000

# LAN IP of this machine (phone access, presigned uploads, pushed links).
# Leave empty to fall back to 127.0.0.1 (same-machine only).
# Use the REAL physical adapter (WLAN/Ethernet) — an OpenVPN/Hyper-V/WSL address
# is only reachable from this machine, so phones and other devices cannot load
# it. Read it with: Get-NetIPAddress -AddressFamily IPv4
PLATFORM_LAN_IP=

# Same address, used by Caddy as the certificate SAN and the no-SNI fallback.
# Clients never send SNI for an IP literal (RFC 6066), so without this Caddy
# matches no site and drops the handshake. Change it, then restart caddy.
LAN_IP=127.0.0.1

# Optional tuning (the workflows fall back to the same defaults if unset)
EMBED_QUOTA_TOKENS=1000000
ALERT_SEVERITY_CRITICAL=0.8
# LobeHub owner account — used when mirroring memories into LobeHub
LOBEHUB_OWNER_EMAIL=owner@agent-platform.local

# Optional second copy of the newest backup artifacts (another disk / NAS /
# synced folder). Backups live on the same machine as the data, so a dead disk
# takes both — this is the only thing that survives that. Empty = skipped.
BACKUP_OFFSITE_DIR=

# In-stack backup service (`backup`): runs on container start, then every
# BACKUP_INTERVAL_HOURS; skips when the last SUCCESSFUL backup is younger than
# BACKUP_MIN_AGE_HOURS, so a machine that stays up does not produce a new
# ~110MB set on every tick.
BACKUP_INTERVAL_HOURS=6
BACKUP_MIN_AGE_HOURS=20

# Caddy: credentials for the optional basic-auth layer in front of the MinIO
# console (see caddy/Caddyfile — the block is commented out by default).
# Generate the hash: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=

# Console (Kiranism ops dashboard) - Clerk publishable key (build-time)
CONSOLE_CLERK_PUBLISHABLE_KEY=

# Alert delivery webhook (optional). Format: generic | slack | discord | feishu
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_FORMAT=generic
# DeepSeek upstream key for stream-bridge (same key the n8n credential uses)
UPSTREAM_API_KEY=

# Telegram bot (alerts push + two-way bridge + voice notes)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# MCP server key (client auth; hash managed in gateway_keys)
MCP_API_KEY=

# ---------------------------------------------------------------------------
# Host ports. Defaults match the container ports; change one here when the new
# machine already owns it (restore.ps1 probes and rewrites these automatically).
# Container-side ports never move, so service-to-service URLs are unaffected.
# ---------------------------------------------------------------------------
N8N_PORT=5678
CONSOLE_PORT=3000
LOBECHAT_PORT=3210
SEARXNG_PORT=8080
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
STREAM_BRIDGE_PORT=3211
# Caddy: four entries because compose cannot do arithmetic on a base port.
CADDY_PORT_CONSOLE=8443
CADDY_PORT_LOBEHUB=8444
CADDY_PORT_N8N=8445
CADDY_PORT_MINIO=8446
