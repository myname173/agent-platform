# =================================================================
# agent-platform secrets & instance config
# Copy to `.env` (gitignored) and fill in real values.
# =================================================================

# n8n image version (pinned; upgrade deliberately)
N8N_VERSION=2.37.7

# n8n credential encryption key.
# First boot auto-generates one into the n8n_data volume (config file);
# read it with: docker exec n8n cat /home/node/.n8n/config
# Changing it after credentials exist makes them undecryptable.
N8N_ENCRYPTION_KEY=

# Task runners auth (n8n internal)
N8N_RUNNERS_AUTH_TOKEN=

# Chat Gateway Bearer key — MUST match LobeChat's OPENAI_API_KEY in
# docker-compose.yml; rotate both together.
CHAT_API_KEY=

# n8n public API key (create in n8n: Settings → n8n API).
# Used by Kiranism server routes (frontent/.env.local) and the retention
# workflow inside n8n itself. Needs workflow + data table scopes.
N8N_API_KEY=

# Data retention (days) for the gateway's data tables
RETENTION_DAYS_MESSAGES=30
RETENTION_DAYS_EXECUTIONS=90
RETENTION_DAYS_IDEMPOTENCY=7
IDEMPOTENCY_WINDOW_SEC=300

# LobeChat access code (UI entry password)
LOBECHAT_ACCESS_CODE=

# LobeChat / NextAuth secret (Auth.js v5 reads AUTH_SECRET; set both for
# backwards compat). Generate: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_SECRET=

# Postgres datastore for n8n (primary DB; volume postgres_data)
POSTGRES_USER=n8n
POSTGRES_PASSWORD=
POSTGRES_DB=n8n

# DashScope (阿里百炼) API key — kb embeddings via qwen3.7-text-embedding
DASHSCOPE_API_KEY=

# 错误率告警（Chat Alerts workflow）
ALERT_WINDOW_MIN=60
ALERT_RATE_THRESHOLD=0.5
ALERT_MIN_TOTAL=5
ALERT_COOLDOWN_MIN=60


# LobeHub 2.x（服务端数据库模式）
LOBECHAT_DATABASE_URL=postgres://lobechat:CHANGE_ME@postgres:5432/lobechat
LOBECHAT_OPENAI_API_KEY=
# Better Auth / 加密（KEY_VAULTS_SECRET=openssl rand -base64 32；JWKS_KEY 为 RS256 JWK Set JSON）
KEY_VAULTS_SECRET=
JWKS_KEY=

# MinIO (S3-compatible object storage) root credentials.
# docker-compose feeds these to both the `minio` service and LobeHub's S3_*
# vars — they must stay identical or presigned uploads fail with 403.
# MinIO enforces a minimum of 8 characters for the secret.
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME

# LAN IP of this machine (phone access, presigned uploads, pushed links).
# Leave empty to fall back to 127.0.0.1 (same-machine only).
PLATFORM_LAN_IP=

# Optional tuning (the workflows fall back to the same defaults if unset)
EMBED_QUOTA_TOKENS=1000000
ALERT_SEVERITY_CRITICAL=0.8
# LobeHub owner account — used when mirroring memories into LobeHub
LOBEHUB_OWNER_EMAIL=owner@agent-platform.local

# Optional second copy of the newest backup artifacts (another disk / NAS /
# synced folder). Backups live on the same machine as the data, so a dead disk
# takes both — this is the only thing that survives that. Empty = skipped.
BACKUP_OFFSITE_DIR=

# Console (Kiranism ops dashboard) - Clerk publishable key (build-time)
CONSOLE_CLERK_PUBLISHABLE_KEY=

# Alert delivery webhook (optional). Format: generic | slack | discord | feishu
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_FORMAT=generic
# DeepSeek upstream key for stream-bridge (same key the n8n credential uses)
UPSTREAM_API_KEY=

# Telegram bot (alerts push + two-way bridge + voice notes)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# MCP server key (client auth; hash managed in gateway_keys)
MCP_API_KEY=
