#!/bin/sh
# =============================================================================
# pre-push guard: 大额删除要肉眼确认，别把旧版本推上去
#
# 背景（2026-10-27）：工作区里三个已跟踪文件被更旧的副本覆盖
# （interview-demo 的 README 793 B vs 44,852 B、演示台 4.4 MB vs 5.3 MB），
# 只差一次 `git add -A && git push` 就会把 GitHub 上的完整版打成旧版，
# 而且因为体积变小，review 时很难看出来。
#
# 默认只警告（exit 0），不阻断流程；确认无误可忽略。
# 要强制拦截：PIVOT_STRICT_PUSH=1 git push
# 临时绕过：git push --no-verify
#
# 第二道闸门（2026-10-29 加）：凭据泄露 —— 把 .env 的真实值写进【本次新增的行】
# 一律【直接拦截】，不受 PIVOT_STRICT_PUSH 影响，因为这类东西推上去就收不回来
# （本仓库曾在 GitHub 上是 public：scripts/check-users.mjs 的库密码、
# demo-assets/_data.json 的 MCP 令牌，公开了整整一个多月）。
# 分级规则与自检见 scripts/secret-scan.sh 头部；只想放行一次：git push --no-verify
#
# 安装：sh scripts/install-git-hooks.sh
# =============================================================================

strict="${PIVOT_STRICT_PUSH:-0}"
zero="0000000000000000000000000000000000000000"
status=0
root=$(git rev-parse --show-toplevel 2>/dev/null) || root=""

while read -r local_ref local_sha remote_ref remote_sha; do
  # 删除远端分支的推送不检查
  [ "$local_sha" = "$zero" ] && continue
  [ -z "$local_sha" ] && continue

  # 基线：远端已有该分支就用远端 sha；新分支则退回到与 origin/main 的分叉点
  if [ -z "$remote_sha" ] || [ "$remote_sha" = "$zero" ]; then
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null) || base=""
  else
    base="$remote_sha"
  fi
  [ -z "$base" ] && continue

  # ---- 凭据闸门：只看这次会新增的行，命中即拦截 ----
  if [ -n "$root" ] && [ -f "$root/scripts/secret-scan.sh" ]; then
    scan_out=$(bash "$root/scripts/secret-scan.sh" --added "${base}..${local_sha}" 2>/dev/null)
    scan_rc=$?
    if [ "$scan_rc" = "1" ]; then
      echo ""
      echo "  [x] 已拦截：本次推送【新增的行】里写进了 .env 的真实凭据（值不打印）"
      printf '%s\n' "$scan_out" | sed 's/^/      /'
      echo "      绕过一次： git push --no-verify"
      echo "      证明这道闸门会拦（不是摆设）： bash scripts/secret-scan.sh --self-test"
      echo ""
      status=1
    elif [ "$scan_rc" != "0" ]; then
      echo "  [!] 凭据闸门没能运行（rc=${scan_rc}，多半是本机没有 .env）—— 这次放行，但请手工跑一次 scripts/secret-scan.sh"
    fi
  fi

  # numstat 第三列是路径；二进制文件的行数列是 "-"
  stats=$(git diff --numstat "$base" "$local_sha" 2>/dev/null)
  [ -z "$stats" ] && continue

  dels=$(printf '%s\n' "$stats" | awk '$2 ~ /^[0-9]+$/ {s+=$2} END {printf "%d", s+0}')
  ins=$(printf '%s\n' "$stats" | awk '$1 ~ /^[0-9]+$/ {s+=$1} END {printf "%d", s+0}')
  delfiles=$(git diff --diff-filter=D --name-only "$base" "$local_sha" 2>/dev/null | wc -l | tr -d ' ')

  trigger=0
  [ "$delfiles" -ge 5 ] && trigger=1
  if [ "$dels" -gt 200 ]; then
    if [ "$dels" -gt $((ins * 5)) ]; then trigger=1; fi
  fi

  if [ "$trigger" = "1" ]; then
    echo ""
    echo "  [!] 这次推送包含大额删除，请确认不是旧版本覆盖新版本："
    echo "      删除文件 ${delfiles} 个 | 删行 ${dels} | 增行 ${ins}"
    git diff --stat "$base" "$local_sha" 2>/dev/null | tail -8 | sed 's/^/      /'
    echo "      完整对照： git diff --stat ${base}..${local_sha}"
    echo ""
    if [ "$strict" = "1" ]; then
      echo "  PIVOT_STRICT_PUSH=1 -> 已拦截。确认无误后用 git push --no-verify 重试。"
      status=1
    fi
  fi
done

exit $status
