    {
      "id": "rmd-parse-create",
      "name": "Parse Create",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -600,
        100
      ],
      "parameters": {
        "jsCode": "/* Validate a create request and compute the due timestamp (stored as UTC ISO). */\nconst body = ($('Webhook Create').first().json.body) || {};\nconst text = String(body.text || '').trim().slice(0, 500);\nconst bad = (status, message, code) => [{ json: { __error: true, status, body: { error: { message, type: 'invalid_request_error', code } } } }];\nif (!text) return bad(400, 'text is required', 'missing_text');\nlet due;\nif (body.delay_minutes !== undefined && body.delay_minutes !== null) {\n  const m = Number(body.delay_minutes);\n  if (!Number.isFinite(m) || m <= 0 || m > 43200) return bad(400, 'delay_minutes must be a number between 1 and 43200', 'bad_delay');\n  due = new Date(Date.now() + m * 60000);\n} else if (body.due_at) {\n  const t = Date.parse(String(body.due_at));\n  if (!Number.isFinite(t)) return bad(400, 'due_at must be ISO 8601 (e.g. 2026-09-17T09:00:00+08:00)', 'bad_due_at');\n  due = new Date(t);\n} else {\n  return bad(400, 'provide due_at or delay_minutes', 'missing_due');\n}\nconst now = Date.now();\nlet adjusted = '';\nif (due.getTime() < now) {\n  if (now - due.getTime() > 300000) return bad(400, 'due time is more than 5 minutes in the past - compute a future time', 'due_in_past');\n  due = new Date(now + 60000);\n  adjusted = 'past-adjusted';\n}\nreturn [{ json: {\n  text,\n  due_at: due.toISOString(),\n  status: 'pending',\n  delivered: '',\n  created_via: String(body.via || 'api').slice(0, 24),\n  attempts: 0,\n  meta: JSON.stringify({ created_at: new Date().toISOString(), adjusted }),\n} }];"
      }
