      "id": "rmd-load",
      "name": "Load Reminders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -600,
        400
      ],
      "parameters": {
        "jsCode": "/* List reminders (newest first) with a readable local time (+08). */\nconst api = (method, path, qs) => this.helpers.httpRequest({ method, url: 'http://localhost:5678/api/v1' + path, headers: { 'X-N8N-API-KEY': $env.N8N_API_KEY }, qs });\nconst tables = (await api('GET', '/data-tables', { limit: 100 })).data || [];\nconst tableId = (tables.find((t) => t.name === 'reminders') || {}).id;\nif (!tableId) return [{ json: { ok: false, error: 'reminders table missing (run deploy.mjs)' } }];\nconst rows = (await api('GET', '/data-tables/' + tableId + '/rows', { limit: 100, sortBy: 'createdAt:desc' })).data || [];\nconst local = (iso) => {\n  const t = Date.parse(iso || '');\n  if (!Number.isFinite(t)) return '';\n  return new Date(t + 8 * 3600000).toISOString().replace('T', ' ').slice(0, 16) + ' +08';\n};\nconst slim = (r) => ({ id: r.id, text: r.text, due_at: r.due_at, due_local: local(r.due_at), status: r.status, delivered: r.delivered || '', attempts: Number(r.attempts || 0) });\nconst pending = rows.filter((r) => r.status === 'pending').sort((a, b) => Date.parse(a.due_at) - Date.parse(b.due_at)).map(slim);\nconst recent = rows.filter((r) => r.status !== 'pending').slice(0, 15).map(slim);\nreturn [{ json: { ok: true, pending_count: pending.length, pending, recent } }];"
      }
    },
