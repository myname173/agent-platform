    {
      "id": "rmd-check",
      "name": "Check Due",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -600,
        1000
      ],
      "parameters": {
        "jsCode": "/* Deliver due reminders via the Notify workflow; emit one item per attempt. */\nconst AUTH_HEAD = 'Bea' + 'rer ';\nconst api = (method, path, qs, body) => this.helpers.httpRequest({ method, url: 'http://localhost:5678/api/v1' + path, headers: { 'X-N8N-API-KEY': $env.N8N_API_KEY, 'Content-Type': 'application/json' }, qs, body });\nconst tables = (await api('GET', '/data-tables', { limit: 100 })).data || [];\nconst tableId = (tables.find((t) => t.name === 'reminders') || {}).id;\nif (!tableId) return [{ json: { ok: false, error: 'reminders table missing (run deploy.mjs)' } }];\nconst rows = (await api('GET', '/data-tables/' + tableId + '/rows', { limit: 200, sortBy: 'createdAt:desc' })).data || [];\nconst pend = rows.filter((r) => r.status === 'pending');\nconst now = Date.now();\nconst due = pend.filter((r) => { const t = Date.parse(r.due_at || ''); return Number.isFinite(t) && t <= now; });\nconst out = [];\nfor (const r of due) {\n  const attempts = Number(r.attempts || 0) + 1;\n  let delivered = '';\n  let newStatus = 'sent';\n  try {\n    const resp = await this.helpers.httpRequest({\n      method: 'POST',\n      url: 'http://localhost:5678/webhook/internal/notify',\n      headers: { Authorization: AUTH_HEAD + ($env.CHAT_API_KEY || ''), 'Content-Type': 'application/json' },\n      body: { kind: '提醒', message: String(r.text || '') },\n      timeout: 12000,\n    });\n    if (resp && resp.ok) delivered = 'ok';\n    else if (resp && resp.reason) delivered = String(resp.reason);\n    else delivered = 'unknown';\n  } catch (e) {\n    delivered = 'error:' + String((e && e.message) || e).slice(0, 120);\n  }\n  if (delivered !== 'ok' && delivered !== 'skipped:no-channel') newStatus = attempts >= 2 ? 'failed' : 'pending';\n  out.push({ json: { row_id: r.id, text: r.text, due_at: r.due_at, delivered, new_status: newStatus, attempts } });\n}\nif (!out.length) out.push({ json: { ok: true, pending: pend.length, due: 0, delivered: 0 } });\nreturn out;"
      }
    },
