      "parameters": {
        "jsCode": "/* Aggregate the delivery results into one summary item. */\nconst items = $input.all().map((i) => i.json);\nif (items.length === 1 && items[0].ok === true && items[0].due === 0) return [{ json: items[0] }];\nconst results = items.map((x) => ({ id: x.id || x.row_id, text: x.text, delivered: x.delivered, status: x.status || x.new_status, attempts: x.attempts }));\nreturn [{ json: {\n  ok: true,\n  due: results.length,\n  delivered_ok: results.filter((x) => x.delivered === 'ok').length,\n  skipped: results.filter((x) => x.delivered === 'skipped:no-channel').length,\n  results,\n} }];"
