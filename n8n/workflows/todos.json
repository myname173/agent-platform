      "parameters": {
        "jsCode": "/* Validate a todo_add request. */\nconst body = ($('Webhook Add').first().json.body) || {};\nconst text = String(body.text || '').trim().slice(0, 300);\nconst bad = (m, c) => [{ json: { __error: true, status: 400, body: { error: { message: m, type: 'invalid_request_error', code: c } } } }];\nif (!text) return bad('text is required', 'missing_text');\nlet due = '';\nif (body.due_date) {\n  const t = Date.parse(String(body.due_date));\n  if (!Number.isFinite(t)) return bad('due_date must be a date like 2026-09-18', 'bad_due_date');\n  due = new Date(t).toISOString().slice(0, 10);\n}\nreturn [{ json: { text, status: 'open', due_date: due, completed_at: '', meta: JSON.stringify({ created_at: new Date().toISOString(), via: String(body.via || 'api').slice(0, 24) }) } }];"
      }
