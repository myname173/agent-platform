        "jsCode": "/* Summarize the complete result. */\nconst rows = $input.all().map((i) => i.json).filter((x) => x && x.id);\nif (!rows.length) return [{ json: { ok: false, error: 'todo not found or already done', tip: 'list with GET /webhook/admin/todos' } }];\nreturn [{ json: { ok: true, done: rows.length, todos: rows.map((r) => ({ id: r.id, text: r.text, status: r.status, completed_at: r.completed_at || '' })) } }];"
