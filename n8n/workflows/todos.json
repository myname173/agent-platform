    {
      "id": "td-load",
      "name": "Load Todos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -800,
        450
      ],
      "parameters": {
        "jsCode": "/* List todos: open (with overdue/due-today flags) + recent done. */\nconst api = (method, path, qs, payload) => this.helpers.httpRequest({ method, url: 'http://localhost:5678/api/v1' + path, headers: { 'X-N8N-API-KEY': $env.N8N_API_KEY, 'Content-Type': 'application/json' }, qs, body: payload });\nconst tables = (await api('GET', '/data-tables', { limit: 100 })).data || [];\nconst id = (tables.find((t) => t.name === 'todos') || {}).id;\nif (!id) return [{ json: { ok: false, error: 'todos table missing (run deploy.mjs)' } }];\nconst rows = (await api('GET', '/data-tables/' + id + '/rows', { limit: 200 })).data || [];\nconst today = new Date(Date.now() + 8 * 3600000).toISOString().slice(0, 10);\nconst slim = (r) => ({ id: r.id, text: r.text, due_date: r.due_date || '', overdue: !!(r.due_date && r.due_date < today), due_today: !!(r.due_date && r.due_date === today) });\nconst open = rows.filter((r) => r.status === 'open').map(slim).sort((a, b) => {\n  if (a.due_date && b.due_date) return a.due_date < b.due_date ? -1 : 1;\n  if (a.due_date) return -1;\n  if (b.due_date) return 1;\n  return 0;\n});\nconst done = rows.filter((r) => r.status === 'done').slice(-10).map((r) => ({ id: r.id, text: r.text, completed_at: r.completed_at || '' }));\nreturn [{ json: { ok: true, today, open_count: open.length, overdue_count: open.filter((x) => x.overdue).length, due_today_count: open.filter((x) => x.due_today).length, open, done_recent: done } }];"
      }
